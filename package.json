{
  "name": "n8n-nodes-pictomancer",
  "version": "0.6.0",
  "description": "n8n community node for Pictomancer.ai - image optimization (resize, compress, convert, crop, pipeline)",
  "license": "MIT",
  "author": {
    "name": "Pictomancer.ai",
    "email": "webmaster+n8n@pictomancer.ai"
  },
  "homepage": "https://pictomancer.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pictomancer/n8n-nodes-pictomancer.git"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "n8n-community-node-package",
    "image",
    "optimization",
    "resize",
    "compress",
    "avif",
    "webp",
    "pictomancer"
  ],
  "engines": {
    "node": ">=20.15"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PictomancerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pictomancer/Pictomancer.node.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');for(const n of ['pictomancer.svg','pictomancer-dark.svg']){fs.copyFileSync('nodes/Pictomancer/'+n,'dist/nodes/Pictomancer/'+n);fs.copyFileSync('credentials/'+n,'dist/credentials/'+n)}\"",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.42.2",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
